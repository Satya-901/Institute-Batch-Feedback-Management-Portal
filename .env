# ==============================================================================
# EDUPULSE INSTITUTE & FACULTY FEEDBACK MANAGEMENT PORTAL - ENVIRONMENT CONFIG
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_NAME="EduPulse - Institute & Faculty Feedback Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# MYSQL / PHPMYADMIN DATABASE CONFIGURATION (PRIMARY LOCAL DATABASE)
# ==============================================================================
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="edupulse_feedback"
MYSQL_CONNECT_TIMEOUT="3000"

# ==============================================================================
# SQLITE DATABASE CONFIGURATION (HOT STANDBY / CLOUD FALLBACK)
# ==============================================================================
# Pure SQLite server database on disk (acts as fallback if MySQL is offline)
SQLITE_DB_PATH="./data/edupulse.sqlite"

# ==============================================================================
# ADMINISTRATIVE AUTHENTICATION & SECURITY
# ==============================================================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="adminpassword123"
ADMIN_SESSION_SECRET="edupulse_institute_master_jwt_secret_token_2026_x89a"

# ==============================================================================
# INSTITUTE DEFAULTS & EVALUATION POLICIES
# ==============================================================================
NEXT_PUBLIC_INSTITUTE_NAME="EduPulse Institute of Advanced Studies"
NEXT_PUBLIC_DEFAULT_ACADEMIC_YEAR="2026-2027"
FEEDBACK_DEFAULT_EXPIRY_DAYS="30"
ALLOW_ANONYMOUS_STUDENT_FEEDBACK="true"
ENABLE_AUTO_PREFILL_PREVIOUS_STUDENT="true"
